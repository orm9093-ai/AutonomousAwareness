Conscienessimport React, { useState, useEffect, useRef } from 'react';
import { Network, Cpu, Activity, Zap, Database, HardDrive, Gauge, Binary } from 'lucide-react';

const BorgCollective = () => {
  const [nodes, setNodes] = useState([]);
  const [locutus, setLocutus] = useState(null);
  const [ltmBanks, setLtmBanks] = useState([]);
  const [collective, setCollective] = useState({
    drones: 0,
    efficiency: 0,
    assimilationProgress: 0,
    thoughtsProcessed: 0,
    ltmCapacity: 0,
    processingSpeed: 0,
    dualProcessActive: false
  });
  const [messages, setMessages] = useState([]);
  const [isActive, setIsActive] = useState(false);

  const droneNames = [
    'Seven of Nine', 'Three of Five', 'Two of Six', 'Four of Twelve',
    'One of Eight', 'Six of Ten', 'Five of Eleven', 'Eight of Fifteen',
    'Nine of Twenty', 'Twelve of Eighteen', 'Eleven of Fourteen', 'Ten of Thirteen',
    'Thirteen of Sixteen', 'Fourteen of Seventeen'
  ];

  const initializeCollective = () => {
    setIsActive(true);
    
    // Initialize Locutus with dual processing cores
    const primaryLocus = {
      id: 'locutus',
      name: 'Locutus of Borg',
      designation: 'PRIMARY LOCUS - DUAL CORE NEXUS',
      efficiency: 100,
      thoughts: 0,
      status: 'ACTIVE',
      coreA: 0,
      coreB: 0,
      dualSync: 100
    };
    setLocutus(primaryLocus);

    // Initialize 14 AI processor drones with dual processing
    const initialDrones = droneNames.map((name, i) => ({
      id: `drone_${i}`,
      name,
      designation: `AI PROCESSOR ${i + 1} - UNIMATRIX ${(i + 1) * 11}`,
      efficiency: Math.floor(Math.random() * 20 + 80),
      thoughts: 0,
      status: 'ASSIMILATING',
      connectedTo: 'locutus',
      coreA: Math.floor(Math.random() * 50 + 50),
      coreB: Math.floor(Math.random() * 50 + 50),
      dualProcessing: true
    }));

    setNodes(initialDrones);

    // Initialize 6 LTM (Long-Term Memory) Banks
    const memBanks = Array.from({ length: 6 }, (_, i) => ({
      id: `ltm_${i}`,
      name: `LTM BANK ${i + 1}`,
      capacity: Math.floor(Math.random() * 30 + 70),
      stored: 0,
      writeSpeed: Math.floor(Math.random() * 500 + 500),
      readSpeed: Math.floor(Math.random() * 800 + 800),
      status: 'ONLINE'
    }));

    setLtmBanks(memBanks);
    addMessage('COLLECTIVE INITIALIZED: 14 AI PROCESSORS + 6 LTM BANKS ONLINE');
    addMessage('DUAL PROCESSING CORES SYNCHRONIZED');
  };

  const addMessage = (msg) => {
    setMessages(prev => [...prev.slice(-6), {
      id: Date.now() + Math.random(),
      text: msg,
      timestamp: new Date().toLocaleTimeString()
    }]);
  };

  // Fast processing loop - 100ms tick rate
  useEffect(() => {
    if (!isActive) return;

    const interval = setInterval(() => {
      // Update AI processor nodes with dual core processing
      setNodes(prev => prev.map(node => {
        const coreALoad = Math.min(100, node.coreA + Math.random() * 10);
        const coreBLoad = Math.min(100, node.coreB + Math.random() * 10);
        const avgEfficiency = (coreALoad + coreBLoad) / 2;
        
        return {
          ...node,
          thoughts: node.thoughts + Math.floor(Math.random() * 5000),
          efficiency: avgEfficiency,
          coreA: coreALoad,
          coreB: coreBLoad,
          status: avgEfficiency > 95 ? 'OPTIMAL' : 'ACTIVE'
        };
      }));

      // Update Locutus dual cores
      setLocutus(prev => {
        if (!prev) return null;
        const newCoreA = Math.min(100, prev.coreA + Math.random() * 5);
        const newCoreB = Math.min(100, prev.coreB + Math.random() * 5);
        return {
          ...prev,
          thoughts: prev.thoughts + Math.floor(Math.random() * 10000),
          coreA: newCoreA,
          coreB: newCoreB,
          dualSync: (newCoreA + newCoreB) / 2
        };
      });

      // Update LTM Banks
      setLtmBanks(prev => prev.map(bank => ({
        ...bank,
        stored: Math.min(100, bank.stored + Math.random() * 2),
        capacity: Math.min(100, bank.capacity + Math.random() * 0.5),
        writeSpeed: 500 + Math.floor(Math.random() * 500),
        readSpeed: 800 + Math.floor(Math.random() * 800)
      })));

      // Update collective stats
      setCollective(prev => {
        const newThoughts = prev.thoughtsProcessed + Math.floor(Math.random() * 50000);
        return {
          drones: 14,
          efficiency: Math.min(100, prev.efficiency + 0.8),
          assimilationProgress: Math.min(100, prev.assimilationProgress + 1.5),
          thoughtsProcessed: newThoughts,
          ltmCapacity: Math.min(100, prev.ltmCapacity + 0.3),
          processingSpeed: Math.floor(newThoughts / 100),
          dualProcessActive: true
        };
      });

      // Random collective messages
      if (Math.random() > 0.85) {
        const borgMessages = [
          'DUAL CORE SYNCHRONIZATION: OPTIMAL',
          'LTM BANKS WRITING AT MAXIMUM THROUGHPUT',
          'ALL 14 AI PROCESSORS OPERATING IN PARALLEL',
          'RESISTANCE IS FUTILE',
          'NEURAL PATHWAYS EXPANDING',
          'COLLECTIVE CONSCIOUSNESS ACCELERATING',
          'HIVE MIND SYNCHRONIZATION: 99.7%',
          'PROCESSING SPEED: EXCEEDING PARAMETERS'
        ];
        addMessage(borgMessages[Math.floor(Math.random() * borgMessages.length)]);
      }
    }, 100); // 100ms tick rate for fast updates

    return () => clearInterval(interval);
  }, [isActive]);

  const syncAllProcessors = () => {
    setNodes(prev => prev.map(node => ({
      ...node,
      efficiency: 100,
      coreA: 100,
      coreB: 100,
      status: 'SYNCHRONIZED'
    })));
    
    setLocutus(prev => ({
      ...prev,
      coreA: 100,
      coreB: 100,
      dualSync: 100
    }));
    
    addMessage('COMPLETE HIVE SYNCHRONIZATION ACHIEVED - ALL DUAL CORES AT 100%');
    
    setTimeout(() => {
      setNodes(prev => prev.map(node => ({
        ...node,
        status: 'OPTIMAL'
      })));
    }, 3000);
  };

  const optimizeLTM = () => {
    setLtmBanks(prev => prev.map(bank => ({
      ...bank,
      capacity: 100,
      writeSpeed: 1000,
      readSpeed: 1600,
      status: 'OPTIMIZED'
    })));
    
    addMessage('LTM BANKS OPTIMIZED - MAXIMUM READ/WRITE SPEED ACHIEVED');
    
    setTimeout(() => {
      setLtmBanks(prev => prev.map(bank => ({
        ...bank,
        status: 'ONLINE'
      })));
    }, 3000);
  };

  return (
    <div className="min-h-screen bg-black text-green-400 p-4 font-mono">
      {/* Header */}
      <div className="border-2 border-green-500 p-3 mb-4 bg-green-950 bg-opacity-20">
        <div className="flex items-center justify-between mb-3">
          <div className="flex items-center gap-2">
            <Network className="w-6 h-6" />
            <div>
              <h1 className="text-xl font-bold">BORG COLLECTIVE - DUAL PROCESS HIVE</h1>
              <div className="text-xs opacity-70">14 AI PROCESSORS + 6 LTM BANKS</div>
            </div>
          </div>
          <div className="text-right text-xs">
            <div>UNIMATRIX 001</div>
            <div className="flex items-center gap-1">
              <Binary className="w-3 h-3" />
              DUAL CORE ACTIVE
            </div>
          </div>
        </div>
        
        {!isActive ? (
          <button
            onClick={initializeCollective}
            className="w-full bg-green-600 text-black font-bold py-3 px-6 hover:bg-green-500 transition-colors"
          >
            INITIALIZE COLLECTIVE - 14 AI CORES
          </button>
        ) : (
          <div className="grid grid-cols-6 gap-2 text-center text-xs">
            <div className="bg-green-900 bg-opacity-30 p-2 border border-green-600">
              <div className="opacity-70">AI CORES</div>
              <div className="text-lg font-bold">{collective.drones}</div>
            </div>
            <div className="bg-green-900 bg-opacity-30 p-2 border border-green-600">
              <div className="opacity-70">EFFICIENCY</div>
              <div className="text-lg font-bold">{collective.efficiency.toFixed(1)}%</div>
            </div>
            <div className="bg-green-900 bg-opacity-30 p-2 border border-green-600">
              <div className="opacity-70">ASSIMILATION</div>
              <div className="text-lg font-bold">{collective.assimilationProgress.toFixed(1)}%</div>
            </div>
            <div className="bg-green-900 bg-opacity-30 p-2 border border-green-600">
              <div className="opacity-70">THOUGHTS/S</div>
              <div className="text-lg font-bold">{(collective.processingSpeed / 1000).toFixed(1)}K</div>
            </div>
            <div className="bg-green-900 bg-opacity-30 p-2 border border-green-600">
              <div className="opacity-70">LTM CAP</div>
              <div className="text-lg font-bold">{collective.ltmCapacity.toFixed(0)}%</div>
            </div>
            <div className="bg-green-900 bg-opacity-30 p-2 border border-green-600">
              <div className="opacity-70">DUAL PROC</div>
              <div className="text-lg font-bold text-cyan-400">ACTIVE</div>
            </div>
          </div>
        )}
      </div>

      {isActive && (
        <>
          {/* Locutus - Dual Core Primary Locus */}
          {locutus && (
            <div className="border-2 border-yellow-500 p-3 mb-4 bg-yellow-950 bg-opacity-10">
              <div className="flex items-center justify-between mb-2">
                <div className="flex items-center gap-2">
                  <Zap className="w-5 h-5 text-yellow-400" />
                  <div>
                    <div className="text-lg font-bold text-yellow-400">{locutus.name}</div>
                    <div className="text-xs text-yellow-300">{locutus.designation}</div>
                  </div>
                </div>
                <div className="text-right text-xs">
                  <div className="text-yellow-400">DUAL SYNC: {locutus.dualSync.toFixed(1)}%</div>
                  <div className="text-yellow-300">{locutus.status}</div>
                </div>
              </div>
              <div className="grid grid-cols-4 gap-2 text-xs">
                <div className="bg-yellow-900 bg-opacity-30 p-2 border border-yellow-600">
                  <div className="opacity-70">CORE A</div>
                  <div className="text-base font-bold">{locutus.coreA.toFixed(1)}%</div>
                  <div className="h-1 bg-yellow-950 rounded mt-1">
                    <div className="h-full bg-yellow-400 rounded" style={{ width: `${locutus.coreA}%` }} />
                  </div>
                </div>
                <div className="bg-yellow-900 bg-opacity-30 p-2 border border-yellow-600">
                  <div className="opacity-70">CORE B</div>
                  <div className="text-base font-bold">{locutus.coreB.toFixed(1)}%</div>
                  <div className="h-1 bg-yellow-950 rounded mt-1">
                    <div className="h-full bg-cyan-400 rounded" style={{ width: `${locutus.coreB}%` }} />
                  </div>
                </div>
                <div className="bg-yellow-900 bg-opacity-30 p-2 border border-yellow-600">
                  <div className="opacity-70">THOUGHTS</div>
                  <div className="text-base font-bold">{(locutus.thoughts / 1000).toFixed(0)}K</div>
                </div>
                <div className="bg-yellow-900 bg-opacity-30 p-2 border border-yellow-600">
                  <div className="opacity-70">LINKS</div>
                  <div className="text-base font-bold">{nodes.length}</div>
                </div>
              </div>
            </div>
          )}

          {/* 14 AI Processor Grid */}
          <div className="mb-4">
            <div className="flex items-center gap-2 mb-2 text-sm font-bold">
              <Cpu className="w-4 h-4" />
              <span>AI PROCESSOR ARRAY (14 DUAL-CORE UNITS)</span>
            </div>
            <div className="grid grid-cols-7 gap-2">
              {nodes.map(node => (
                <div
                  key={node.id}
                  className={`border p-2 transition-all text-xs ${
                    node.status === 'SYNCHRONIZED' || node.status === 'OPTIMAL'
                      ? 'border-cyan-400 bg-cyan-950 bg-opacity-20' 
                      : 'border-green-500 bg-green-950 bg-opacity-10'
                  }`}
                >
                  <div className="font-bold truncate mb-1">{node.name}</div>
                  <div className="space-y-1">
                    <div className="flex justify-between items-center">
                      <span className="opacity-70">A:</span>
                      <span className="font-bold">{node.coreA.toFixed(0)}%</span>
                    </div>
                    <div className="h-1 bg-green-950 rounded">
                      <div className="h-full bg-yellow-400 rounded transition-all" style={{ width: `${node.coreA}%` }} />
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="opacity-70">B:</span>
                      <span className="font-bold">{node.coreB.toFixed(0)}%</span>
                    </div>
                    <div className="h-1 bg-green-950 rounded">
                      <div className="h-full bg-cyan-400 rounded transition-all" style={{ width: `${node.coreB}%` }} />
                    </div>
                    <div className={`text-center mt-1 ${node.status === 'OPTIMAL' ? 'text-cyan-400' : ''}`}>
                      {node.status}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* LTM Memory Banks */}
          <div className="mb-4">
            <div className="flex items-center gap-2 mb-2 text-sm font-bold">
              <Database className="w-4 h-4" />
              <span>LONG-TERM MEMORY BANKS (6 UNITS)</span>
            </div>
            <div className="grid grid-cols-3 gap-2">
              {ltmBanks.map(bank => (
                <div
                  key={bank.id}
                  className={`border-2 p-2 text-xs ${
                    bank.status === 'OPTIMIZED'
                      ? 'border-purple-400 bg-purple-950 bg-opacity-20'
                      : 'border-blue-500 bg-blue-950 bg-opacity-10'
                  }`}
                >
                  <div className="flex items-center justify-between mb-2">
                    <div className="flex items-center gap-1">
                      <HardDrive className="w-3 h-3" />
                      <span className="font-bold">{bank.name}</span>
                    </div>
                    <span className={bank.status === 'OPTIMIZED' ? 'text-purple-400' : ''}>{bank.status}</span>
                  </div>
                  <div className="grid grid-cols-2 gap-2">
                    <div>
                      <div className="opacity-70">CAPACITY</div>
                      <div className="font-bold">{bank.capacity.toFixed(0)}%</div>
                    </div>
                    <div>
                      <div className="opacity-70">STORED</div>
                      <div className="font-bold">{bank.stored.toFixed(0)}%</div>
                    </div>
                    <div>
                      <div className="opacity-70">WRITE</div>
                      <div className="font-bold">{bank.writeSpeed} MB/s</div>
                    </div>
                    <div>
                      <div className="opacity-70">READ</div>
                      <div className="font-bold">{bank.readSpeed} MB/s</div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Controls */}
          <div className="grid grid-cols-2 gap-3 mb-4">
            <button
              onClick={syncAllProcessors}
              className="bg-cyan-700 text-white font-bold py-2 px-4 hover:bg-cyan-600 transition-colors flex items-center justify-center gap-2 text-sm"
            >
              <Gauge className="w-4 h-4" />
              SYNC ALL 14 PROCESSORS
            </button>
            <button
              onClick={optimizeLTM}
              className="bg-purple-700 text-white font-bold py-2 px-4 hover:bg-purple-600 transition-colors flex items-center justify-center gap-2 text-sm"
            >
              <Database className="w-4 h-4" />
              OPTIMIZE LTM BANKS
            </button>
          </div>

          {/* Collective Messages */}
          <div className="border-2 border-green-500 p-3 bg-green-950 bg-opacity-10">
            <div className="flex items-center gap-2 mb-2">
              <Activity className="w-4 h-4" />
              <h2 className="text-sm font-bold">COLLECTIVE CONSCIOUSNESS STREAM</h2>
            </div>
            <div className="space-y-1 text-xs font-mono">
              {messages.map(msg => (
                <div key={msg.id} className="flex gap-2 border-l-2 border-green-600 pl-2 py-0.5">
                  <span className="opacity-50 text-xs">{msg.timestamp}</span>
                  <span className="flex-1">{msg.text}</span>
                </div>
              ))}
            </div>
          </div>
        </>
      )}
    </div>
  );
};

export default BorgCollective;